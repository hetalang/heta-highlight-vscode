{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Heta language",
	"scopeName": "source.heta",
	"fileTypes": [ "heta" ],
	"limitLineLength": false,
	"patterns": [
		{ "include": "#linecomment" },
		{ "include": "#blockcomment" },
		{ "include": "#invalidEmptyNote" },
		{ "include": "#note" },
		{ "include": "#invalidIncludeStatement" },
		{ "include": "#includeStatement" },
		{ "include": "#namespace" },
		{ "include": "#basestruct" }
	],
	"repository": {
		"unknown": {
			"name": "invalid.illegal.heta",
			"match": ".+"
		},
		"index": {
			"name": "meta.index.heta",
			"match": "(?:([A-Za-z_][A-Za-z0-9_]*)::)?([A-Za-z_][A-Za-z0-9_]*|\\*)",
			"captures":{
				"2": {
					"name": "variable.parameter.id.heta"
				}
			}
		},
		"assignmentConst": {
			"name": "meta.assignment.heta",
			"match": "(=)\\s*(?:([-+]?(?:NaN|Infinity)\\b|[-+]?(?:(?:[0-9]+(?:\\.[0-9]+)?)|(?:\\.[0-9]+))(?:[eE][-+]?[0-9]+)?\\b)|\\b(null)\\b)(?=\\s*(?:[;{#@']))",
			"captures": {
				"1": {
					"name": "keyword.operator.assignment.heta"
				},
				"2": {
					"name": "constant.numeric.heta"
				},
				"3": {
					"name": "constant.language.heta"
				}
			}
		},
		"invalidAssignmentConst": {
			"name": "invalid.illegal.assignment.heta",
			"match": "(=)\\s*[^;\\r\\n]*(?=;)",
			"captures": {
				"1": {
					"name": "keyword.operator.assignment.heta"
				}
			}
		},
		"assignment": {
			"name": "meta.assignment.heta",
			"begin": "([.:]=|`=)|(\\[([A-Za-z_][A-Za-z0-9_]*)?\\]=)",
			"end": "(?=[;{@#'])",
			"beginCaptures": {
				"0": {
					"name": "keyword.operator.assignment.heta"
				},
				"3": {
					"name": "variable.parameter.heta"
				}
			},
			"patterns": [
				{ "include": "#quotedAssignmentString" },
				{ 
					"match": "[^;{\"@#']+",
					"name": "string.other.expression.heta"
				}
			]
		},
		"quotedAssignmentString": {
			"name": "string.other.expression.heta",
			"begin": "\"",
			"end": "(?<!\\\\)\""
		},
		"invalidStringAssignment": {
			"name": "invalid.illegal.assignment.heta",
			"match": "(?:[.:]=|`=|\\[[^\\]\\r\\n]*\\]=)\\s*(?=;)|\\[(?:[0-9][^\\]\\r\\n]*|[A-Za-z_][A-Za-z0-9_]*[^A-Za-z0-9_\\]\\r\\n][^\\]\\r\\n]*|[^A-Za-z0-9_\\]\\r\\n][^\\]\\r\\n]*)\\]=",
			"captures": {
				"0": {
					"name": "invalid.illegal.assignment.heta"
				}
			}
		},
		"invalidIncludeStatement": {
			"name": "invalid.illegal.include.heta",
			"match": "\\binclude\\b[ \\t]*(?=(?://|/\\*|;|$))|\\binclude\\b[ \\t]+\"?[A-Za-z0-9._/\\\\-]+\"?(?:[ \\t]+type[ \\t]+\"?[A-Za-z0-9]+\"?)?[ \\t]+with\\b(?![ \\t]*\\{)|\\binclude\\b[ \\t]+\"?[A-Za-z0-9._/\\\\-]+\"?[ \\t]+type[ \\t]+\"?[A-Za-z0-9]*_[^\\s\"]*\"?"
		},
		"includeStatement": {
			"name": "meta.include.heta",
			"match": "(include)\\s+(\"?[A-Za-z0-9._/\\\\-]+\"?)(?:\\s+(type)\\s+(\"?[A-Za-z0-9]+\"?))?(?:\\s+(with)\\s+(\\{.+\\}))?",
			"captures": {
				"1": {
					"name": "keyword.control.reserved.heta"
				},
				"2": {
					"name": "string.other.heta"
				},
				"3": {
					"name": "keyword.control.reserved.heta"
				},
				"4": {
					"name": "string.other.heta"
				},
				"5": {
					"name": "keyword.control.reserved.heta"
				},
				"6": {
					"name": "entity.other.heta"
				}
			}
		},
		"namespace": {
			"name": "meta.namespace.heta",
			"begin": "(\\b(abstract|concrete)\\b)?\\s*\\b(namespace)\\b\\s+(?:(?!//|/\\*)[^\\r\\n])*\\s+(begin)\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.reserved.heta"
				},
				"3": {
					"name": "keyword.control.reserved.heta"
				},
				"5": {
					"name": "keyword.control.begin.heta"
				}
			},
			"end": "end",
			"endCaptures": {
				"0": { "name": "keyword.control.end.heta" }
			},
			"patterns": [
				{ "include": "#linecomment" },
				{ "include": "#blockcomment" },
				{ "include": "#invalidIncludeStatement" },
				{ "include": "#includeStatement" },
				{ "include": "#invalidEmptyNote" },
				{ "include": "#note"},
				{ "include": "#basestruct"}
			]
		},
		"basestruct": {
			"name": "meta.basestruct.heta",
			"end": ";",
			"patterns": [
				{ "include": "#invalidIdentifier" },
				{ "include": "#invalidIndex" },
				{ "include": "#index" },
				{ "include": "#linecomment" },
				{ "include": "#blockcomment" },
				{ "include": "#invalidEmptyNote" },
				{ "include": "#note" },
				{ "include": "#invalidClass" },
				{ "include": "#class" },
				{ "include": "#invalidAction" },
				{ "include": "#action" },
				{ "include": "#invalidEmptyTitle" },
				{ "include": "#title" },
				{ "include": "#dict" },
				{ "include": "#assignmentConst" },
				{ "include": "#invalidAssignmentConst" },
				{ "include": "#invalidStringAssignment" },
				{ "include": "#assignment" }
			]
		},
		"invalidIdentifier": {
			"name": "invalid.illegal.identifier.heta",
			"match": "(?<![A-Za-z0-9_])(?:[0-9]+[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*-[A-Za-z0-9_-]+)(?![A-Za-z0-9_])"
		},
		"invalidIndex": {
			"name": "invalid.illegal.index.heta",
			"match": "(?:[A-Za-z_][A-Za-z0-9_]*|\\*)::\\s*(?=;|$)|::(?:[A-Za-z_][A-Za-z0-9_]*|\\*)|:{3,}"
		},
		"dict": {
			"begin": "\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.block.begin.heta"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.block.end.heta"
				}
			},
			"name": "meta.dictionary.heta",
			"patterns": [
				{ "include": "#linecomment" },
				{ "include": "#blockcomment" },
				{ "include": "#invalidDictionaryKey" },
				{ "include": "#invalidDictionaryValue" },
				{
					"name": "entity.other.heta",
					"begin": "([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*",
					"beginCaptures": {
						"1": {
							"name": "variable.other.property.heta"
						}
					},
					"end": ",|(?=//)|(?=/\\*)|(?=})",
					"patterns": [
						{ "include": "#dict" },
						{ "include": "#array" },
						{ "include": "#boolean" },
						{ "include": "#null" },
						{ "include": "#unitExpression" },
						{ "include": "#number" },
						{ "include": "#string" }
					]
				}
			]
		},
		"number": {
			"name": "constant.numeric.heta",
			"match": "(?:[-+]?(?:NaN|Infinity)\\b)|(?:[-+]?(?:(?:[0-9]+(?:\\.[0-9]+)?)|(?:\\.[0-9]+))(?:[eE][-+]?[0-9]+)?\\b)"
		},
		"unitExpression": {
			"name": "string.other.expression.heta",
			"match": "[-+]?(?:(?:[0-9]+(?:\\.[0-9]+)?)|(?:\\.[0-9]+))(?:[eE][-+]?[0-9]+)?(?:\\s*/\\s*[A-Za-z_][A-Za-z0-9_]*)+\\b"
		},
		"boolean": {
			"name": "constant.language.heta",
			"match": "\\b(true|false)\\b"
		},
		"null": {
			"name": "constant.language.heta",
			"match": "\\bnull\\b"
		},
		"string": {
			"name": "string.other.heta",
			"match": "(?<!\\\\)\".*?(?<!\\\\)\"|[^\"]*?(?=(//|/\\*|,|}|]|$))"
		},
		"invalidDictionaryKey": {
			"name": "invalid.illegal.dictionary-key.heta",
			"match": "(?<=\\{|,)\\s*(?:\"[^\"]*\"|[0-9][^\\s:]*|[A-Za-z_][A-Za-z0-9_]*(?:\\s+\\S+|[^A-Za-z0-9_\\s][^\\s:]*)|[^\\s:A-Za-z0-9_][^\\s:]*)\\s*:"
		},
		"invalidDictionaryValue": {
			"name": "invalid.illegal.dictionary-value.heta",
			"match": "[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*(?=,|})"
		},
		"array": {
			"name": "meta.array.heta",
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{ "include": "#linecomment" },
				{ "include": "#blockcomment" },
				{ "match": "\\s+" },
				{	
					"begin": "",
					"end": ",|(?=//)|(?=/\\*)|(?=\\])",
					"endCaptures": {
						"0": {
							"name": "array.end.heta"
						}
					},
					"patterns": [
						{ "include": "#dict" },
						{ "include": "#array" },
						{ "include": "#boolean" },
						{ "include": "#null" },
						{ "include": "#unitExpression" },
						{ "include": "#number" },
						{ "include": "#string" }
					]
				}
			]
		},
		"note": {
			"name": "comment.block.documentation.note.heta",
			"begin": "'''",
			"end": "'''"
		},
		"invalidEmptyNote": {
			"name": "invalid.illegal.empty-note.heta",
			"match": "(?<!')'{6}(?!')"
		},
		"invalidClass": {
			"name": "invalid.illegal.class.heta",
			"match": "@(?:(?![A-Za-z_])[^\\s;]+|[A-Za-z_][A-Za-z0-9_]*[^A-Za-z0-9_\\s;{#@'=:.\\[/][^\\s;]*)|@(?=\\s*(?:;|$))"
		},
		"class": {
			"name": "support.class.heta",
			"match": "@[A-Za-z_][A-Za-z0-9_]*"
		},
		"invalidEmptyTitle": {
			"name": "invalid.illegal.empty-title.heta",
			"match": "(?<!')''(?!')"
		},
		"title": {
			"name": "string.quoted.single.heta",
			"begin": "(?<!')'(?!'')",
			"end": "'"
		},
		"linecomment": {
			"name": "comment.line.double-slash.heta",
			"begin": "//",
			"end": "$"
		},
		"blockcomment": {
			"name": "comment.block.heta",
			"begin": "/\\*",
			"end": "\\*/"
		},
		"invalidAction": {
			"name": "invalid.illegal.action.heta",
			"match": "#(?:(?![A-Za-z_])[^\\s;]+|[A-Za-z_][A-Za-z0-9_]*[^A-Za-z0-9_\\s;{#@'=:.\\[/][^\\s;]*)|#(?=\\s*(?:;|$))"
		},
		"action": {
			"name": "support.function.action.heta",
			"match": "#[A-Za-z_][A-Za-z0-9_]*"
		}
	}
}
